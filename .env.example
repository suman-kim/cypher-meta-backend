# 서버
PORT=4000
CORS_ORIGIN=http://localhost:3000

# 로컬 Postgres (이미 설치된 인스턴스에 맞춰 값 수정)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=admin
DB_PASSWORD=admin
DB_NAME=cyphers
# 개발 중에는 true → 엔티티대로 테이블 자동 생성/동기화 (운영은 false + 마이그레이션)
DB_SYNC=true

# Neople 오픈API (백엔드에서 프록시/캐싱)
NEOPLE_API_KEY=여기에_발급받은_키를_입력하세요

# 치지직(CHZZK) 오픈 API — 메인 '지금 방송 중'(사이퍼즈 라이브) 섹션용.
# 치지직 개발자센터(https://developers.chzzk.naver.com)에서 앱 등록 후 발급.
# ※ 시크릿은 서버에서만 사용(프론트 노출 금지).
CHZZK_CLIENT_ID=여기에_치지직_클라이언트_ID
CHZZK_CLIENT_SECRET=여기에_치지직_시크릿

# 유튜브 Data API v3 — 메인 '지금 방송 중' 유튜브 라인용(Google Cloud Console 발급).
# search.list 쿼터가 빡빡해 기본 15분 캐시. 사이퍼즈 카테고리가 없어 검색어 기반.
YOUTUBE_API_KEY=여기에_유튜브_API_키
# YOUTUBE_TTL_SEC=900

# 메타 자동 수집 스케줄러 (부팅 후 최초 1회 + 주기 수집)
# ※ 아래 META_* 수집 설정값은 이제 DB 테이블(collection_config)로 이관되었습니다.
#   백엔드 최초 부팅 시 이 env 값으로 1회 '시딩'되며, 이후에는 관리자 페이지
#   (/admin → 수집 관리 탭, x-admin-token=ADMIN_TOKEN)에서 DB 값을 직접 수정합니다.
#   즉 env 는 최초 시드/폴백 용도이며, 시딩 후 값 변경은 env 가 아니라 DB 에서 하세요.
#   수집 실행 이력·커버한 랭커 범위·자동/수동 여부는 collection_run 테이블에 기록됩니다.
META_AUTO_COLLECT=true          # (시드) false 로 끄기
META_COLLECT_INTERVAL_HOURS=6   # 수집 주기(시간)
META_COLLECT_INITIAL_DELAY_SEC=30  # 부팅 후 최초 수집까지 지연(초)
META_COLLECT_RANKERS=20         # 수집할 상위 랭커 수
META_COLLECT_PER_PLAYER=10      # 플레이어당 매치 수
META_COLLECT_GAME_TYPE=rating   # rating(공식전) | normal(일반전)

# ===== 프로덕션 / Vercel 배포용 =====
# Neon 등 호스팅 DB 연결 문자열 (설정되면 위 DB_HOST/PORT/... 대신 이걸 사용).
# → Neon의 "Pooled connection"(호스트명에 -pooler 포함) 문자열을 추천.
# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require
DB_SSL=true                     # 서버리스 Postgres는 SSL 필요 (DATABASE_URL 있으면 기본 true)
DB_POOL_MAX=5                   # 커넥션 풀 최대치 (서버리스면 작게)

# Vercel Cron 보안 — Vercel 프로젝트 환경변수에 동일값 설정 시,
# /api/meta/cron/collect 는 Authorization: Bearer <값> 이 있어야 실행됨.
CRON_SECRET=

# Cron 회전 수집 — 매일 window명씩 구간 이동, maxRank 도달 시 1위부터 다시.
# 예: WINDOW=10, MAX_RANK=500 → 하루 10명씩 → 50일에 한 바퀴. (perPlayer는 META_COLLECT_PER_PLAYER 공유)
META_CRON_WINDOW=10
META_CRON_MAX_RANK=500
